@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

if(@ODYPLAN_USE_SYSTEM_DEPS@)
    find_dependency(spdlog REQUIRED)
    find_dependency(nlohmann_json REQUIRED)
    message(STATUS "OdyPlan requires system spdlog and nlohmann_json")
else()
    message(WARNING "OdyPlan was built with FetchContent!")
endif()

include("${CMAKE_CURRENT_LIST_DIR}/OdyPlanTargets.cmake")

check_required_components(OdyPlan)